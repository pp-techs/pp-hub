#: src/list-editor.tsx
msgid "{done} of {total} done"
msgstr "Đã xong {done}/{total}"

#: src/list-editor.tsx
msgid "A checklist holds at most 500 items"
msgstr "Một danh sách việc chứa tối đa 500 mục"

#: src/list-editor.tsx
msgid "Add"
msgstr "Thêm"

#: src/list-editor.tsx
msgid "Add an item…"
msgstr "Thêm một mục…"

#: src/list-editor.tsx
msgid "checklist"
msgstr "danh sách việc"

#: src/bridge/app-provider.tsx
msgid "Close"
msgstr "Đóng"

#: src/list-editor.tsx
msgid "Could not update the checklist"
msgstr "Không thể cập nhật danh sách việc"

#: src/list-editor.tsx
msgid "Delete item"
msgstr "Xóa mục"

#: src/bridge/app-provider.tsx
msgid "It may have been deleted, or you may no longer have access to it."
msgstr "Có thể nó đã bị xoá, hoặc bạn không còn quyền truy cập."

#: src/bridge/app-provider.tsx
msgid "It only works when opened from pp-hub. Reload the page to try again."
msgstr "Ứng dụng chỉ hoạt động khi được mở từ pp-hub. Hãy tải lại trang để thử lại."

#: src/bridge/app-provider.tsx
msgid "Loading…"
msgstr "Đang tải…"

#: src/bridge/app-provider.tsx
msgid "More"
msgstr "Thêm"

#: src/list-editor.tsx
msgid "New item"
msgstr "Mục mới"

#: src/list-editor.tsx
msgid "Nothing on this list yet"
msgstr "Danh sách chưa có mục nào"

#: src/bridge/app-provider.tsx
msgid "This {what} could not be opened"
msgstr "Không thể mở {what} này"

#: src/bridge/app-provider.tsx
msgid "This app could not reach pp-hub"
msgstr "Ứng dụng này không kết nối được với pp-hub"

#: src/bridge/app-provider.tsx
msgid "This app is switched off for this space. Your {what} is kept; an admin can turn the app back on."
msgstr "Ứng dụng này đang tắt trong không gian này. Dữ liệu của {what} vẫn được giữ; quản trị viên có thể bật lại ứng dụng."

#: src/bridge/app-provider.tsx
msgid "This app is turned off"
msgstr "Ứng dụng này đã bị tắt"

#: src/bridge/app-provider.tsx
msgid "Try again"
msgstr "Thử lại"
