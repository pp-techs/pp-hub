# pp-hub environment variables
# Copy to .env and adjust values for your environment

# ============================================
# Server Configuration
# ============================================

# Address to listen on
PP_ADDR=:8080

# PostgreSQL connection string
PP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/pphub?sslmode=disable

# OIDC / Logto Configuration
# Issuer URL: Logto Cloud (https://<tenant-id>.logto.app/oidc) or self-hosted
# (http://localhost:3001/oidc from compose.logto.yml)
PP_OIDC_ISSUER=https://your-tenant-id.logto.app/oidc
# Issuer URL as reachable by user's browser - leave empty to default to PP_OIDC_ISSUER
# PP_OIDC_ISSUER_EXTERNAL=

# OIDC Client credentials (create in Logto Console > Applications > Traditional Web)
PP_OIDC_CLIENT_ID=your-app-id
PP_OIDC_CLIENT_SECRET=your-app-secret

# Public base URL of this server
PP_EXTERNAL_URL=http://localhost:8080

# Session key for HMAC cookies (base64 encoded, >=32 bytes)
# Generate with: openssl rand -base64 32
PP_SESSION_KEY=

# Enable insecure dev mode (fixed session key, for development only)
PP_DEV_INSECURE=1

# ============================================
# Storage Configuration
# ============================================

# Local blob storage root directory
PP_BLOB_ROOT=./data/blobs

# ============================================
# OnlyOffice Configuration
# ============================================

# OnlyOffice Document Server URL (browser-facing)
PP_ONLYOFFICE_URL=http://localhost:9980

# OnlyOffice calls back to this URL (container network)
PP_WOPI_SERVER_URL=http://localhost:8080
