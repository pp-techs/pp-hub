# Production environment for compose.prod.yml.
#
#   cp deploy/compose/.env.prod.example deploy/compose/.env.prod
#   docker compose -f deploy/compose/compose.prod.yml \
#     --env-file deploy/compose/.env.prod up -d --build
#
# `--env-file` is REQUIRED, not optional. Compose would otherwise auto-load
# `.env` from this directory — which is the *development* file (see
# .env.dev.example), and a prod stack silently inheriting PP_DEV_INSECURE=1
# and development S3 credentials is exactly the failure this naming avoids.
# Passing --env-file replaces that default lookup entirely.
#
# In Dokploy, paste these into the Environment tab instead of committing a file.
#
# Committed: `.env.prod.example` and `.env.dev.example`.
# Yours, git-ignored: `.env.prod` and `.env`.
#
# Every REQUIRED value has no default: compose refuses to start and names the
# missing variable rather than booting a half-configured stack.

# ── Public URLs ──────────────────────────────────────────────────────────────
# REQUIRED. The address users type. Also the OIDC redirect base, so it must
# match the domain assigned to the `web` service, scheme included. Use https:
# the Secure flag on session cookies is derived from this scheme and nothing
# else, and the server warns at startup when it is not https.
PP_EXTERNAL_URL=https://drive.example.com

# REQUIRED. The domain assigned to the `onlyoffice` service. The browser loads
# the editor from here in an iframe, so it must be publicly reachable — an
# internal service name will not work.
PP_ONLYOFFICE_URL=https://office.example.com

# ── Secrets ──────────────────────────────────────────────────────────────────
# REQUIRED. Postgres password.
POSTGRES_PASSWORD=

# REQUIRED. Master secret, base64 of >=32 bytes:
#   openssl rand -base64 32
# Nothing signs with it directly: every signer takes a purpose-bound subkey
# through HKDF. Today that is the WOPI access token, which the worker signs
# and the server verifies — so the two must share this value, and leaving it
# unset gives each process its own random key and office thumbnails never
# appear. Sessions are rows in Postgres, not signatures: rotating this signs
# nobody out, it only invalidates WOPI tokens currently in flight.
PP_SESSION_KEY=

# REQUIRED. The Document Server's shared signing secret:
#   openssl rand -base64 32
# Its own variable rather than a subkey of the one above, because the other
# holder is a third-party container configured from this file and it cannot
# run our derivation. It is the Document Server's only access control: with
# JWT_ENABLED=true nothing that merely reaches its port can drive its
# conversion API, which is what stops ALLOW_PRIVATE_IP_ADDRESS from being an
# open door into this network. The worker signs every conversion request with
# it; a mismatch shows up as {"error":-8} in the worker's logs.
PP_ONLYOFFICE_JWT_SECRET=

# ── OIDC ─────────────────────────────────────────────────────────────────────
# REQUIRED. Logto Cloud or any OIDC provider. Register with it:
#   redirect URI        https://drive.example.com/auth/callback
#   post-logout redirect https://drive.example.com
#
# PP_OIDC_ISSUER is the issuer *this server* reaches: discovery, token,
# userinfo and JWKS are fetched from it.
PP_OIDC_ISSUER=https://your-tenant.logto.app/oidc
PP_OIDC_CLIENT_ID=
PP_OIDC_CLIENT_SECRET=
# Only in a split horizon, where the IdP answers on a container hostname
# inside the network and a public domain outside it. This is the issuer the
# *browser* is sent to and the value that must appear in the `iss` claim; the
# authorization and end-session endpoints are rebased onto it, while token,
# userinfo and JWKS stay on PP_OIDC_ISSUER because only the server calls them.
# Unset, it defaults to PP_OIDC_ISSUER and nothing is rebased.
# PP_OIDC_ISSUER_EXTERNAL=

# ── Storage ──────────────────────────────────────────────────────────────────
# "local" keeps blobs in the blob_data volume — simplest, but pins the stack to
# one host. "s3" is what allows more than one `server` replica. An unknown
# value, or s3 without a bucket, fails at startup rather than silently writing
# to the wrong place.
PP_BLOB_BACKEND=local

# Self-hosted object storage on the same box:
#   docker compose -f compose.prod.yml --env-file .env.prod --profile s3 up -d
# then point the app at the bundled SeaweedFS. These same credentials are what
# the seaweedfs container writes into its own s3.json at startup — there is no
# second SEAWEEDFS_* pair to keep in sync.
# PP_BLOB_BACKEND=s3
# PP_S3_BUCKET=pphub
# PP_S3_ENDPOINT=http://seaweedfs:8333
# PP_S3_ACCESS_KEY_ID=pphub
# PP_S3_SECRET_ACCESS_KEY=change-me
# PP_S3_PATH_STYLE=1
#
# Or an external provider (AWS, Wasabi, Backblaze…):
# PP_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# PP_S3_REGION=us-east-1
# PP_S3_PATH_STYLE=0
#
# The key layout is identical to local disk, so migrating an existing install
# is a plain copy:  aws s3 sync ./data/blobs s3://<bucket>/
