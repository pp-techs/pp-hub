# Server environment for connecting to Logto + OnlyOffice
# Usage:
#   1. Source this file: source deploy/compose/server.env
#   2. Or copy to apps/server/.env

# ============================================
# Server
# ============================================
PP_ADDR=:8080
PP_EXTERNAL_URL=http://localhost:8080

# Database (compose.pg-oo.yml creates user/db "pphub"; local PG may differ)
PP_DATABASE_URL=postgres://pphub:pphub@localhost:5432/pphub?sslmode=disable

# ============================================
# OIDC / Logto
# ============================================
# Issuer URL: Logto Cloud (https://<tenant-id>.logto.app/oidc) or self-hosted
# (http://localhost:3001/oidc from compose.logto.yml)
PP_OIDC_ISSUER=https://your-tenant-id.logto.app/oidc
# Issuer URL override - leave empty to default to PP_OIDC_ISSUER
# PP_OIDC_ISSUER_EXTERNAL=

# Client credentials (Logto Console > Applications > your Traditional Web app)
PP_OIDC_CLIENT_ID=your-app-id
PP_OIDC_CLIENT_SECRET=your-app-secret

# ============================================
# OnlyOffice
# ============================================
PP_ONLYOFFICE_URL=http://localhost:9980
# URL OnlyOffice uses to call back to server (container/host network)
PP_WOPI_SERVER_URL=http://host.docker.internal:8080

# ============================================
# Storage
# ============================================
PP_BLOB_ROOT=./data/blobs

# ============================================
# Development
# ============================================
# Dev mode: uses fixed session key (DO NOT use in production)
PP_DEV_INSECURE=1

# Production: generate with: openssl rand -base64 32
# PP_SESSION_KEY=
