# Development environment for compose.dev.yml.
#
#   cp deploy/compose/.env.dev.example deploy/compose/.env
#   docker compose -f deploy/compose/compose.dev.yml \
#     --profile idp --profile worker --profile s3 up -d
#
# This one is named plain `.env` because compose auto-loads it from the compose
# file's directory. The production file is `.env.prod` and must be passed with
# --env-file — see .env.prod.example.
#
# Every value here has a working default inside compose.dev.yml; this file only
# exists to override them and to document what the overrides are for.
#
#   idp    self-hosted Logto (issuer http://localhost:3001/oidc)
#   worker PDF/video/office thumbnails
#   s3     SeaweedFS S3 gateway on http://localhost:8333

# Host port for the dev Postgres. Change it when 5432 is already taken on your
# machine by another local Postgres; apps/server/.env must then use the same
# port in PP_DATABASE_URL.
PP_POSTGRES_PORT=5432

# --profile worker only: how OnlyOffice and the worker reach the Go server,
# which runs on your host rather than on the compose network.
PP_WOPI_SERVER_URL=http://host.docker.internal:8080

# Fixed dev session key in both the worker and the host server, so the WOPI
# tokens the worker signs verify server-side (office thumbnails). NEVER in
# production — compose.prod.yml requires a real PP_SESSION_KEY.
PP_DEV_INSECURE=1

# ── Blob backend ─────────────────────────────────────────────────────────────
# The worker reads and writes the same blobs as the server, so it must use the
# same backend — these mirror apps/server/.env.
#
# `local` (default): the worker bind-mounts apps/server/data/blobs, so both
# processes see one store.
PP_BLOB_BACKEND=local
#
# For the S3 path, run --profile s3 and set PP_BLOB_BACKEND=s3 here *and* in
# apps/server/.env. Only the endpoint differs per side: the host server uses
# http://localhost:8333, the worker the compose-network address below.
PP_S3_ENDPOINT_INTERNAL=http://seaweedfs:8333
PP_S3_BUCKET=pphub
# Must match seaweedfs/s3.json, which holds development credentials only.
PP_S3_ACCESS_KEY_ID=pphub
PP_S3_SECRET_ACCESS_KEY=pphub-dev-secret
PP_S3_PATH_STYLE=1
