# Local development environment for the Go server.
#
#   cp apps/server/.env.example apps/server/.env
#   cd apps/server && set -a && source .env && set +a && go run ./cmd/server
#
# The server reads real environment variables only — there is no dotenv loader
# in the binary — so this file has to be *sourced*, not just present.
#
# Convention: `.env.example` is committed, `.env` is yours and git-ignored.
# The same pair exists at deploy/compose/.env.example for the production stack.
# Values here assume the services from deploy/compose/compose.dev.yml, which
# publish their ports to localhost.

PP_ADDR=:8080
PP_EXTERNAL_URL=http://localhost:8080

# compose.dev.yml creates user/db "pphub".
PP_DATABASE_URL=postgres://pphub:pphub@localhost:5432/pphub?sslmode=disable

# ── OIDC ─────────────────────────────────────────────────────────────────────
# Logto Cloud (https://<tenant>.logto.app/oidc), or http://localhost:3001/oidc
# with `--profile idp`. Register the redirect URI http://localhost:8080/auth/callback
PP_OIDC_ISSUER=https://your-tenant.logto.app/oidc
PP_OIDC_CLIENT_ID=your-app-id
PP_OIDC_CLIENT_SECRET=your-app-secret
# Only when the issuer differs between the server and the browser.
# PP_OIDC_ISSUER_EXTERNAL=

# ── OnlyOffice ───────────────────────────────────────────────────────────────
# Browser-facing: goes into the editor iframe.
PP_ONLYOFFICE_URL=http://localhost:9980
# How OnlyOffice reaches *this* server. It runs in Docker while the server runs
# on your host, so localhost would point at the container itself.
PP_WOPI_SERVER_URL=http://host.docker.internal:8080

# ── Storage ──────────────────────────────────────────────────────────────────
# Relative to the working directory, so run the server from apps/server or this
# moves. The `worker` profile bind-mounts this exact path.
PP_BLOB_ROOT=./data/blobs

PP_BLOB_BACKEND=local
# With `--profile s3` (SeaweedFS from compose.dev.yml):
# PP_BLOB_BACKEND=s3
# PP_S3_BUCKET=pphub
# PP_S3_ENDPOINT=http://localhost:8333
# PP_S3_ACCESS_KEY_ID=pphub
# PP_S3_SECRET_ACCESS_KEY=pphub-dev-secret
# PP_S3_PATH_STYLE=1

# ── Development ──────────────────────────────────────────────────────────────
# Fixed development session key. NEVER in production — but it must be set here
# if you want office thumbnails, since the worker container needs to derive the
# same key to sign conversion tokens this server verifies.
PP_DEV_INSECURE=1

# Production instead: openssl rand -base64 32
# PP_SESSION_KEY=
