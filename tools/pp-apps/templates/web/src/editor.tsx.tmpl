import { useQuery } from "@tanstack/react-query";
import { useLingui } from "@lingui/react/macro";
import { api, ExtUnavailable, extQueryKey, extRetry, isAppOff, LoadingStatus } from "@pp-hub/ext-sdk";
import { Skeleton } from "@workspace/ui/components/skeleton";

/** The shape of GET /api/v1/ext/{{id}}/items/{nodeID}/; see apps/server/ext/{{id}}/handlers.go. */
interface Item {
  id: string;
  name: string;
  notes: number;
  caps: { view: boolean; edit: boolean };
}

/** The full-page editor of a {{Name}} node. The route supplies the header; this fills what is under it. */
export default function {{Pascal}}Editor({ nodeId }: { nodeId: string }) {
  const { t } = useLingui();
  const item = useQuery({
    // eslint-disable-next-line lingui/no-unlocalized-strings -- extension id and route segment
    queryKey: extQueryKey("{{id}}", "item", nodeId),
    // eslint-disable-next-line lingui/no-unlocalized-strings -- URL path
    queryFn: async (): Promise<Item> => {
      // eslint-disable-next-line lingui/no-unlocalized-strings -- URL path, not copy
      const res = await api.get(`ext/{{id}}/items/${nodeId}/`);
      return res.json();
    },
    retry: extRetry,
  });

  if (item.isPending) {
    return (
      <LoadingStatus className="mx-auto max-w-xl p-6">
        <Skeleton className="h-7 w-full" />
      </LoadingStatus>
    );
  }
  if (!item.data) {
    return (
      <ExtUnavailable
        what={t`item`}
        off={isAppOff(item.error)}
        onRetry={() => void item.refetch()}
      />
    );
  }
  return (
    <div className="mx-auto max-w-xl p-6">
      <h1 className="text-lg font-medium">{item.data.name}</h1>
    </div>
  );
}
