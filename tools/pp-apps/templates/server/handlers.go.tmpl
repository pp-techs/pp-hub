package {{id}}

import (
	"net/http"

	"github.com/nhatbui/pp-hub/apps/server/extsdk"
)

type itemDTO struct {
	ID   string      `json:"id"`
	Name string      `json:"name"`
	Caps extsdk.Caps `json:"caps"`
	// Notes is how many rows ext_{{id}}.notes holds for the item.
	Notes int `json:"notes"`
}

// handleItem answers GET /api/v1/ext/{{id}}/items/{nodeID}/. Guard has already
// checked the node is an item and the caller may view it; MustRequest returns
// what it found.
func (s *service) handleItem(w http.ResponseWriter, r *http.Request) {
	q := extsdk.MustRequest(r)
	var notes int
	err := s.db.QueryRow(r.Context(),
		`SELECT count(*) FROM ext_{{id}}.notes WHERE item_id = $1`, q.Node.ID).Scan(&notes)
	if err != nil {
		extsdk.Fail(w, err)
		return
	}
	extsdk.WriteJSON(w, http.StatusOK, itemDTO{
		ID:   extsdk.UUIDString(q.Node.ID),
		Name: q.Node.Name,
		Caps: q.Caps,
		Notes: notes,
	})
}
