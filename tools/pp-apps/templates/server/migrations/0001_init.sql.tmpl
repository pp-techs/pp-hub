-- An item is a node; its notes are the rows below. Purging the node takes them
-- with it.
CREATE TABLE notes (
    id         UUID PRIMARY KEY DEFAULT gen_random_uuid(),
    item_id    UUID NOT NULL REFERENCES public.nodes(id) ON DELETE CASCADE,
    body       TEXT NOT NULL CHECK (btrim(body) <> '' AND char_length(body) <= 2000),
    created_by UUID REFERENCES public.users(id) ON DELETE SET NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT now()
);
CREATE INDEX notes_by_item ON notes (item_id, created_at);
