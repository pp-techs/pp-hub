/* The host writes its theme onto :root (--background, --foreground, --primary…) and toggles .dark. */
* {
  box-sizing: border-box;
}
body {
  margin: 0;
  font:
    14px/1.5 system-ui,
    sans-serif;
  background: var(--background);
  color: var(--foreground);
}
main {
  max-width: 640px;
  margin: 0 auto;
  padding: 16px;
}
form,
li {
  display: flex;
  gap: 8px;
}
ul {
  list-style: none;
  margin: 16px 0;
  padding: 0;
  display: grid;
  gap: 8px;
}
input {
  flex: 1;
  padding: 6px 10px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: transparent;
  color: inherit;
  font: inherit;
}
input[readonly] {
  border-color: transparent;
}
button {
  padding: 6px 12px;
  border: 1px solid var(--border);
  border-radius: var(--radius);
  background: transparent;
  color: inherit;
  font: inherit;
  cursor: pointer;
}
button[type="submit"] {
  border-color: var(--primary);
  background: var(--primary);
  color: var(--primary-foreground);
}
#empty {
  color: var(--muted-foreground);
}
