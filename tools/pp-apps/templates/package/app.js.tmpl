// {{Name}}: a zero-build pp-hub app. The SDK (app-sdk.js, types in app-sdk.d.ts) is the only import.
import { connect } from "./app-sdk.js";

const COLLECTION = "items";

const app = await connect();
const canEdit = app.context.caps.edit;
const list = document.getElementById("list");
const empty = document.getElementById("empty");
const form = document.getElementById("add");

/** @type {Map<string, import("./app-sdk.d.ts").AppRecord>} */
const items = new Map();

const fail = (err) => void app.ui.toast(err.message, "error");

async function refetch() {
  const records = await app.records.list(COLLECTION);
  items.clear();
  for (const r of records) items.set(r.id, r);
  render();
}

function render() {
  const sorted = [...items.values()].sort((a, b) => a.created_at.localeCompare(b.created_at));
  list.replaceChildren(...sorted.map(row));
  empty.hidden = items.size > 0;
}

/** @param {import("./app-sdk.d.ts").AppRecord} r */
function row(r) {
  const li = document.createElement("li");
  const input = document.createElement("input");
  input.value = typeof r.data.text === "string" ? r.data.text : "";
  input.readOnly = !canEdit;
  input.addEventListener("change", async () => {
    try {
      // ifRev turns a concurrent edit into a 409 instead of a silent overwrite.
      items.set(r.id, await app.records.merge(r.id, { text: input.value }, { ifRev: r.rev }));
    } catch (err) {
      if (err.status === 409) void app.ui.toast("Someone else changed this item; reloaded.");
      else fail(err);
      await refetch();
    }
  });
  li.append(input);
  if (canEdit) {
    const del = document.createElement("button");
    del.textContent = "Delete";
    del.addEventListener("click", () => {
      app.records.delete(r.id).catch(fail);
    });
    li.append(del);
  }
  return li;
}

form.hidden = !canEdit;
form.addEventListener("submit", async (e) => {
  e.preventDefault();
  const text = form.elements.text.value.trim();
  if (!text) return;
  try {
    const r = await app.records.create(COLLECTION, { text });
    items.set(r.id, r);
    form.reset();
    render();
  } catch (err) {
    fail(err);
  }
});

// Live: every viewer's writes arrive as record events; after a reconnect, refetch.
app.on("records", (e) => {
  if (e.type === "record.upsert" && e.record.collection === COLLECTION)
    items.set(e.record.id, e.record);
  else if (e.type === "record.delete") items.delete(e.id);
  render();
});
app.on("stream", (e) => {
  if (e.state === "reconnected") refetch().catch(fail);
});

await refetch();
