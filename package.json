{
  "name": "pp-hub",
  "version": "1.0.1",
  "private": true,
  "homepage": "https://github.com/pp-techs/pp-hub#readme",
  "bugs": {
    "url": "https://github.com/pp-techs/pp-hub/issues"
  },
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pp-techs/pp-hub.git"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/*",
    "examples/apps/kanban",
    "examples/apps/checklist"
  ],
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run web#i18n:extract && vp run -r test && vp run -r build",
    "dev": "vp run web#dev",
    "prepare": "vp config",
    "check": "vp check",
    "apps": "bun tools/pp-apps/src/cli.ts",
    "apps:build": "vp run --filter '@pp-hub/app-*' build && vp run --no-cache --filter '@pp-hub/app-*' pack",
    "changeset": "changeset",
    "version-packages": "bun scripts/version-packages.ts"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@shadcn/lint": "^0.2.0",
    "eslint-plugin-lingui": "0.16.0",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "overrides": {
    "vite": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.2",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@0.3.1",
    "vite-plus": "0.3.1"
  }
}
